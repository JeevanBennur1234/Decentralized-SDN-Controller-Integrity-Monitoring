# Enforce LF line endings for all text files checked out on any OS.
# Shell scripts with CRLF will fail on Linux with "bad interpreter" errors.

* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.html  text eol=lf

*.pem   binary
*.png   binary
*.jpg   binary
